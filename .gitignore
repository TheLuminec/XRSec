/raw_datasets/
/processed_datasets/
/runs/

__pycache__/
model/__pycache__/*

# Cached sampled windows (safe to delete; rebuilt on demand)
/.cache/

# Sweep checkpoints and state (results/runs.csv keeps the numbers)
/sweeps/

# Derived view of the results log, rebuilt after every run (results/runs/ is the record).
results/runs_all.csv

# Any other sweep artifact root (checkpoints; the numbers live in results/runs/)
/sweeps_*/

# Local Claude session state and per-session git worktrees. `git add -A` staged another
# session's worktree as a gitlink into a commit on 2026-09-10; it must never be tracked.
.claude/
# Pilot sweep artifact roots - same reason as /sweeps/. Untracked 2026-09-10; the
# checkpoints stay on disk and remain in git history, and no acceptance certificate
# references them. The balance pilot's result is recorded in CLAUDE.md as INVALID.
/pilot_*/
external_sota/

# Raw dataset sources, venv and machine-to-machine exchange staging.
# NOT merely large: external_datasets/boxrr-23 is raw BOXRR-23, and committing it
# to a remote is a clause 4 distribution event under the UC Berkeley agreement.
# These were untracked and unignored until 2026-09-17, so any `git add -A` in this
# repo would stage 68GB including that corpus. See CLAUDE.md, "Data".
.venv/
external_datasets/
exchange_from_miami/
manifests_for_miami/

# generated per-node by docs/acceptance/nymeria_in_domain_lists.py: absolute paths, regenerate on each node
configs/nymeria_in_domain_*.yaml
